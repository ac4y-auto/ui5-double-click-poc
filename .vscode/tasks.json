{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "serve:local",
            "type": "shell",
            "command": "node start.js",
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^(🚀|Starting)",
                    "endsPattern": "^(server started|✅|URL: http)"
                }
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "group": "serve"
            }
        },
